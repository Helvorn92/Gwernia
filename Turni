<body>
<div id="app"></div>
<script>
// ── CONSTANTS ──────────────────────────────────────────────────────────────
const BUILTINS=[
  {id:'riposo',    nome:'Riposo',          colore:'#ef4444',oraInizio:'',     oraFine:''     },
  {id:'mattina',   nome:'Turno Mattina',   colore:'#94a3b8',oraInizio:'09:00',oraFine:'14:00'},
  {id:'pomeriggio',nome:'Turno Pomeriggio',colore:'#94a3b8',oraInizio:'13:00',oraFine:'20:00'},
  {id:'intero',    nome:'Turno Intero',    colore:'#475569',oraInizio:'09:00',oraFine:'20:00'},
  {id:'trasferta', nome:'Trasferta',       colore:'#b45309',oraInizio:'',     oraFine:''     },
];
const GN=['Lun','Mar','Mer','Gio','Ven','Sab','Dom'];
const MN=['Gen','Feb','Mar','Apr','Mag','Giu','Lug','Ago','Set','Ott','Nov','Dic'];

// ── STATE ──────────────────────────────────────────────────────────────────
let S={
  cat:'tecnici', weekStart:null, staff:[], programmi:[], turni:{},
  modalStaff:false, modalProg:false, editProg:null, cellModal:null, removePrompt:null,
  dragging:null, history:[]
};

// ── PERSISTENCE & UNDO ─────────────────────────────────────────────────────
function save(push = true){
  const data = {staff:S.staff, programmi:S.programmi, turni:S.turni};
  localStorage.setItem('turni_v5', JSON.stringify(data));
  if(push) {
    S.history.push(JSON.stringify(data));
    if(S.history.length > 50) S.history.shift();
  }
}
function load(){
  try {
    const d = JSON.parse(localStorage.getItem('turni_v5')||'{}');
    S.staff=d.staff||[]; S.programmi=d.programmi||[]; S.turni=d.turni||{};
    S.history = [JSON.stringify({staff:S.staff, programmi:S.programmi, turni:S.turni})];
  } catch(e) { console.error("Load error", e); }
}
function undo(){
  if(S.history.length <= 1) return;
  S.history.pop();
  const last = JSON.parse(S.history[S.history.length-1]);
  S.staff=last.staff; S.programmi=last.programmi; S.turni=last.turni;
  localStorage.setItem('turni_v5', JSON.stringify(last));
  render();
}

// ── DATE UTILS ─────────────────────────────────────────────────────────────
function toISO(d){return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function fromISO(s){const[y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d)}
function addDays(iso,n){const d=fromISO(iso);d.setDate(d.getDate()+n);return toISO(d)}
function getMonday(iso){
  const d=fromISO(iso),day=d.getDay(),diff=day===0?-6:1-day;
  d.setDate(d.getDate()+diff);return toISO(d);
}
function getDow(iso){const day=fromISO(iso).getDay();return day===0?6:day-1}
function weekOffset(iso,baseISO){
  const d=fromISO(getMonday(iso)),b=fromISO(getMonday(baseISO||iso));
  return Math.round((d-b)/(7*86400*1000));
}

// ── CORE LOGIC ─────────────────────────────────────────────────────────────
function getShift(pid, iso) {
  const manual = S.turni[`${pid}|${iso}|${S.cat}`];
  if(manual) return manual.blocked ? null : manual;
  
  const person = S.staff.find(s => s.id === pid);
  if(!person) return null;
  const dow = getDow(iso), mon = fromISO(iso).getMonth();

  for(const pg of S.programmi) {
    if(!pg.giorni || !pg.giorni.includes(dow)) continue;
    if(pg.mesi && pg.mesi.length && !pg.mesi.includes(mon)) continue;
    
    if(pg.turnazione) {
      const rot = (pg.rotazioni && pg.rotazioni[person.ruolo]) || [];
      if(!rot.length) continue;
      const di = pg.giorni.indexOf(dow), wo = weekOffset(iso, pg.baseDate), len = rot.length;
      if(rot[((di+wo)%len+len)%len] === pid) return pg;
    } else {
      if((pg.fissi && pg.fissi[dow] || []).includes(pid)) return pg;
    }
  }
  return null;
}

function handleDrop(pid, iso, type, id) {
  const person = S.staff.find(s => s.id === pid);
  if(!person) return;
  const dow = getDow(iso);

  if(type === 'builtin') {
    delete S.turni[`${pid}|${iso}|${S.cat}`];
    const bi = BUILTINS.find(b => b.id === id);
    if(['mattina', 'pomeriggio', 'intero'].includes(id)) {
      let pg = S.programmi.find(p => p.nome === bi.nome && !p.isRealProg);
      if(!pg) {
        pg = {id:Math.random().toString(36).slice(2,9), nome:bi.nome, colore:bi.colore, oraInizio:bi.oraInizio, oraFine:bi.oraFine, giorni:[0,1,2,3,4,5,6], turnazione:false, fissi:{}, isRealProg:false};
        S.programmi.push(pg);
      }
      if(!pg.fissi[dow]) pg.fissi[dow] = [];
      if(!pg.fissi[dow].includes(pid)) pg.fissi[dow].push(pid);
    } else {
      S.turni[`${pid}|${iso}|${S.cat}`] = {eventoId:id, oraInizio:bi.oraInizio, oraFine:bi.oraFine, manual:true};
    }
  } else {
    const pg = S.programmi.find(p => p.id === id);
    if(!pg) return;
    const isPrimaMattina = pg.nome.toLowerCase().includes('prima mattina');

    if(isPrimaMattina) {
      // 1. Rimuovi Christian da altri giorni della settimana
      S.programmi.forEach(p => {
        if(p.nome.toLowerCase().includes('prima mattina') && p.fissi) {
          for(let d=0; d<7; d++) if(p.fissi[d]) p.fissi[d] = p.fissi[d].filter(x => x !== pid);
        }
      });
      // 2. Unicità per ruolo nel giorno
      const sameRoleIds = S.staff.filter(s => s.ruolo === person.ruolo && s.cat === person.cat).map(s => s.id);
      if(!pg.fissi) pg.fissi = {};
      if(pg.fissi[dow]) pg.fissi[dow] = pg.fissi[dow].filter(sid => !sameRoleIds.includes(sid));
      // 3. Avviso settimanale
      const prev = getShift(pid, addDays(iso, -7));
      if(prev && prev.id === pg.id) alert(`Attenzione: ${person.cognome} era già in Prima Mattina il ${GN[dow]} scorso.`);
      
      delete S.turni[`${pid}|${iso}|${S.cat}`];
      if(!pg.fissi[dow]) pg.fissi[dow] = [];
      pg.fissi[dow].push(pid);
      if(!pg.giorni.includes(dow)) { pg.giorni.push(dow); pg.giorni.sort(); }
    } else {
      delete S.turni[`${pid}|${iso}|${S.cat}`];
      if(!pg.giorni.includes(dow)) { pg.giorni.push(dow); pg.giorni.sort(); }
      if(pg.turnazione) {
        if(!pg.rotazioni) pg.rotazioni = {};
        if(!pg.rotazioni[person.ruolo]) pg.rotazioni[person.ruolo] = [];
        const rot = pg.rotazioni[person.ruolo];
        if(!rot.includes(pid)) rot.push(pid);
        const targetIdx = ((pg.giorni.indexOf(dow) + weekOffset(iso, pg.baseDate)) % rot.length + rot.length) % rot.length;
        const curIdx = rot.indexOf(pid);
        [rot[curIdx], rot[targetIdx]] = [rot[targetIdx], rot[curIdx]];
      } else {
        if(!pg.fissi) pg.fissi = {};
        if(!pg.fissi[dow]) pg.fissi[dow] = [];
        if(!pg.fissi[dow].includes(pid)) pg.fissi[dow].push(pid);
      }
    }
  }
  save(); render();
}

// ── RENDER ENGINE ──────────────────────────────────────────────────────────
function render(){
  const app = document.getElementById('app');
  app.innerHTML = `
    <div class="topbar">
      <h1>📺 Gestione Turni</h1>
      <div class="week-nav">
        <button onclick="changeWeek(-7)">‹</button>
        <span class="week-label">${fmtWeekLabel()}</span>
        <button onclick="changeWeek(7)">›</button>
      </div>
      <div class="tab-btns">
        <button class="tab-btn ${S.cat==='tecnici'?'active':''}" onclick="setCat('tecnici')">Tecnici</button>
        <button class="tab-btn ${S.cat==='giornalisti'?'active':''}" onclick="setCat('giornalisti')">Giornalisti</button>
      </div>
      <div class="action-btns">
        <button class="btn btn-undo" onclick="undo()">↶ Annulla</button>
        <button class="btn btn-export" onclick="exportPDF()">PDF</button>
        <button class="btn btn-secondary" onclick="S.modalStaff=true;render()">👥 Personale</button>
        <button class="btn btn-primary" onclick="S.modalProg=true;S.editProg='list';render()">📋 Programmi</button>
      </div>
    </div>
    <div class="strip">
      <span class="strip-label">Trascina:</span>
      ${BUILTINS.map(b => `<div class="pill" draggable="true" data-type="builtin" data-id="${b.id}" style="background:${b.colore}">${b.nome}</div>`).join('')}
      <div class="strip-sep"></div>
      ${S.programmi.filter(p=>p.isRealProg!==false).map(p => `<div class="pill" draggable="true" data-type="prog" data-id="${p.id}" style="background:${p.colore}">${esc(p.nome)}</div>`).join('')}
    </div>
    <div class="grid-wrap" id="capture-area">
      <div id="pdf-header"><h2>Turni ${S.cat.toUpperCase()} - ${fmtWeekLabel()}</h2></div>
      <table class="grid">
        <thead><tr><th>Nome</th>${Array.from({length:7}, (_,i) => `<th>${GN[i]}<br><small>${addDays(S.weekStart,i).split('-').slice(1).reverse().join('/')}</small></th>`).join('')}</tr></thead>
        <tbody>${staffSorted(S.cat).map(s => `<tr><td><b>${esc(s.cognome)} ${esc(s.nome)}</b><div class="role-badge">${esc(s.ruolo)}</div></td>${Array.from({length:7}, (_,i) => buildCell(s.id, addDays(S.weekStart,i))).join('')}</tr>`).join('')}</tbody>
      </table>
    </div>
    ${S.modalStaff?modalStaff():''} ${S.modalProg?modalProg():''} ${S.cellModal?cellModal():''} ${S.removePrompt?removePrompt():''}
  `;
  bindDrag();
}

function buildCell(pid, iso) {
  const sh = getShift(pid, iso);
  let inner = '';
  if(sh) {
    const bi = BUILTINS.find(b => b.id === (sh.eventoId || sh.id));
    const col = bi?.colore || sh.colore || '#6366f1';
    const name = bi?.nome || sh.nome || sh.nomeImprovvisato;
    const time = sh.oraInizio ? `${sh.oraInizio}–${sh.oraFine}` : '';
    const conflict = conflictCheck(pid, iso);
    inner = `<div class="cell-chip" style="border-color:${col}; background:${hexToRgba(col, 0.12)}">
      <div class="chip-name">${esc(name)}${conflict?`<span class="conflict-dot"></span>`:''}</div>
      ${time?`<div class="chip-time">${time}</div>`:''}
    </div>`;
  }
  return `<td><div class="cell" data-pid="${pid}" data-iso="${iso}">${inner}</div></td>`;
}

// ── UTILS & EVENTS ──────────────────────────────────────────────────────────
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function hexToRgba(h,a){const r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);return`rgba(${r},${g},${b},${a})`}
function fmtWeekLabel(){const s=fromISO(S.weekStart),e=fromISO(addDays(S.weekStart,6));return`${s.getDate()} ${MN[s.getMonth()]} - ${e.getDate()} ${MN[e.getMonth()]} ${e.getFullYear()}`}
function changeWeek(n){S.weekStart=addDays(S.weekStart,n);render()}
function setCat(c){S.cat=c;render()}

function bindDrag(){
  document.querySelectorAll('.pill').forEach(p => {
    p.ondragstart = e => { S.dragging = {type:p.dataset.type, id:p.dataset.id}; e.dataTransfer.effectAllowed='copy'; };
  });
  document.querySelectorAll('.cell').forEach(c => {
    c.ondragover = e => { e.preventDefault(); c.classList.add('drag-over'); };
    c.ondragleave = () => c.classList.remove('drag-over');
    c.ondrop = e => { e.preventDefault(); c.classList.remove('drag-over'); if(S.dragging) handleDrop(c.dataset.pid, c.dataset.iso, S.dragging.type, S.dragging.id); };
    c.onclick = () => { S.cellModal = {pid:c.dataset.pid, date:c.dataset.iso}; render(); };
  });
}

// ── MODALS (Simplified for speed) ──────────────────────────────────────────
function modalStaff(){
  return `<div class="modal-overlay" onclick="S.modalStaff=false;render()">
    <div class="modal" onclick="event.stopPropagation()">
      <h2>Gestione Personale</h2>
      <div class="staff-list">${S.staff.filter(s=>s.cat===S.cat).map(s=>`<div class="list-item"><div class="info">${esc(s.cognome)} ${esc(s.nome)}</div><button class="del" onclick="removeStaff('${s.id}')">✕</button></div>`).join('')}</div>
      <div class="form-row"><input type="text" id="s-cognome" placeholder="Cognome"></div>
      <div class="form-row"><input type="text" id="s-nome" placeholder="Nome"></div>
      <div class="form-row"><select id="s-ruolo"><option>Cameraman</option><option>Montatore</option><option>Regista</option></select></div>
      <button class="btn btn-primary" style="width:100%" onclick="addStaff()">Aggiungi</button>
    </div>
  </div>`;
}
function addStaff(){
  const c=document.getElementById('s-cognome').value, n=document.getElementById('s-nome').value;
  if(!c||!n)return;
  S.staff.push({id:Math.random().toString(36).slice(2,9), cognome:c, nome:n, ruolo:document.getElementById('s-ruolo').value, cat:S.cat});
  save(); render();
}
function removeStaff(id){ S.staff=S.staff.filter(s=>s.id!==id); save(); render(); }

function modalProg(){
  if(S.editProg==='list'){
    return `<div class="modal-overlay" onclick="S.modalProg=false;render()">
      <div class="modal" onclick="event.stopPropagation()">
        <h2>Programmi</h2>
        <div class="prog-list">${S.programmi.filter(p=>p.isRealProg!==false).map(p=>`<div class="list-item"><div class="info">${esc(p.nome)}</div><button class="del" onclick="S.programmi=S.programmi.filter(x=>x.id!=='${p.id}');save();render()">✕</button></div>`).join('')}</div>
        <button class="btn btn-primary" style="width:100%" onclick="S.editProg={id:Math.random().toString(36).slice(2,9),nome:'',colore:'#3b82f6',giorni:[],turnazione:false,isRealProg:true};render()">+ Nuovo</button>
      </div>
    </div>`;
  }
  return `<div class="modal-overlay">
    <div class="modal">
      <h2>Nuovo Programma</h2>
      <div class="form-row"><input type="text" id="pg-nome" placeholder="Nome"></div>
      <div class="form-row"><input type="color" id="pg-col" value="#3b82f6"></div>
      <div class="form-row"><label>Giorni (0-6)</label><input type="text" id="pg-giorni" placeholder="Es: 0,1,2"></div>
      <div class="modal-footer"><button class="btn btn-secondary" onclick="S.editProg='list';render()">Annulla</button><button class="btn btn-primary" onclick="saveProg()">Salva</button></div>
    </div>
  </div>`;
}
function saveProg(){
  const p=S.editProg; p.nome=document.getElementById('pg-nome').value; p.colore=document.getElementById('pg-col').value;
  p.giorni=document.getElementById('pg-giorni').value.split(',').map(Number);
  S.programmi.push(p); save(); S.editProg='list'; render();
}

function cellModal(){
  const sh = getShift(S.cellModal.pid, S.cellModal.date);
  return `<div class="modal-overlay" onclick="S.cellModal=null;render()">
    <div class="modal" onclick="event.stopPropagation()">
      <h2>Evento Singolo</h2>
      <div class="form-row"><input type="text" id="im-nome" placeholder="Nome" value="${sh?.nomeImprovvisato||''}"></div>
      <div class="form-row"><input type="time" id="im-ini" value="${sh?.oraInizio||''}"> <input type="time" id="im-fin" value="${sh?.oraFine||''}"></div>
      <button class="btn btn-primary" style="width:100%" onclick="saveImpro()">Salva</button>
      ${sh?`<button class="btn btn-danger" style="width:100%;margin-top:10px" onclick="clearCell()">Rimuovi</button>`:''}
    </div>
  </div>`;
}
function saveImpro(){
  const n=document.getElementById('im-nome').value, i=document.getElementById('im-ini').value, f=document.getElementById('im-fin').value;
  S.turni[`${S.cellModal.pid}|${S.cellModal.date}|${S.cat}`] = {nomeImprovvisato:n, oraInizio:i, oraFine:f, manual:true};
  save(); S.cellModal=null; render();
}
function clearCell(){
  S.turni[`${S.cellModal.pid}|${S.cellModal.date}|${S.cat}`] = {blocked:true};
  save(); S.cellModal=null; render();
}

async function exportPDF(){
  const h=document.getElementById('pdf-header'); h.style.display='block';
  const c=await html2canvas(document.getElementById('capture-area'),{scale:2}); h.style.display='none';
  const p=new jspdf.jsPDF('l','mm','a4'); const w=p.internal.pageSize.getWidth(), r=Math.min((w-20)/c.width,(p.internal.pageSize.getHeight()-30)/c.height);
  p.addImage(c.toDataURL('image/png'),'PNG',(w-c.width*r)/2,15,c.width*r,c.height*r); p.save('Turni.pdf');
}

window.onkeydown=e=>{if((e.ctrlKey||e.metaKey)&&e.key==='z'){e.preventDefault();undo();}};
load(); S.weekStart=getMonday(toISO(new Date())); render();
</script>
